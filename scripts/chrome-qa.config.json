{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "channel": "chrome",
      "headless": false,
      "ignoreDefaultArgs": ["--disable-backgrounding-occluded-windows", "--disable-renderer-backgrounding", "--disable-background-timer-throttling"]
    },
    "contextOptions": { "viewport": { "width": 1280, "height": 1000 } }
  }
}
